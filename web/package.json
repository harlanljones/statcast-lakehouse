{
  "name": "statcast-lakehouse-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "export:scenarios": "cd .. && python3 -m ingestion.scenarios --out web/public/scenarios",
    "build:static": "npm run export:scenarios && VITE_STATIC_SCENARIOS=1 vite build",
    "deploy": "npm run build:static && npx wrangler pages deploy dist",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/extensions": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "apache-arrow": "^21.2.0",
    "fzstd": "^0.1.1",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.2"
  }
}
